# Reference only: this plain PHP app does not automatically parse .env files.
# Export these variables in your shell/web-server config, or load them with the
# environment tooling you prefer. Never commit real credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=root
DB_PASSWORD=

# Symfony Mailer DSN. Leave blank to run the app without outbound email.
SMTP_DSN=
MAIL_FROM_ADDRESS=library@example.com
MAIL_FROM_NAME="Library System"
